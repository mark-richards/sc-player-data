# ── SuperCoach Draft API ───────────────────────────────────────────────────
# Auto token refresh (preferred) — values from secrets.R / your SC social login:
#   SC_CLIENT_ID   = the `cid` value  (Auth0 client_id)
#   SC_SOCIAL_TOKEN = the `tkn` value (Auth0 social token / ID token)
# When both are set, the pipeline POSTs to the SC access_token endpoint to get a
# fresh bearer automatically — no manual token updates needed.
SC_CLIENT_ID=your_auth0_client_id_here
SC_SOCIAL_TOKEN=your_auth0_social_token_here

# Fallback: static Bearer token (manual refresh required when it expires).
# Only used if SC_CLIENT_ID / SC_SOCIAL_TOKEN are not set.
SC_API_TOKEN=your_bearer_token_here

# Your SC Draft league ID (found in the league URL)
LEAGUE_ID=4199

# Current AFL season year
SEASON_YEAR=2026

# ── Email delivery ─────────────────────────────────────────────────────────
# Outlook SMTP password (or app password if 2FA is on).
# Leave blank to disable emailing.
EMAIL_PASSWORD=your_outlook_password_here

# ── Anthropic API (AI-generated newsletter blurbs) ─────────────────────────
# Required for LLM blurbs in the newsletter. Get your key at console.anthropic.com
# If not set, newsletter falls back to table-only format (no blurbs).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google Sheets ──────────────────────────────────────────────────────────
# Name of the Google Spreadsheet (must be shared with your service account)
GSHEET_NAME=SuperCoach Weekly Predictions

# Path to your Google service account JSON key file (relative to project root)
SERVICE_ACCOUNT_FILE=service_account.json
